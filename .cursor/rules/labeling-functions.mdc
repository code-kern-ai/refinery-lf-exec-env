# Labeling Function Execution Patterns

## Labeling Function Types

### Classification Functions
```python
# ✅ GOOD - Classification function signature
from typing import Dict, Any

def lf(record: Dict[str, Any]) -> str | None:
    """Return a label string or None for no label."""
    if some_condition(record):
        return "positive_label"
    return None  # No label assigned

# Result format: {record_id: [1.0, label_name]}
def run_classification(record_dict_list: list[dict[str, Any]]) -> dict[str, list[float, str]]:
    lf_results_by_record_id = {}
    for record_dict in record_dict_list:
        label_name = lf(record_dict["data"])
        if label_name is not None:
            lf_results_by_record_id[record_dict["id"]] = [1.0, label_name]
    return lf_results_by_record_id
```

### Extraction Functions
```python
# ✅ GOOD - Extraction function signature (generator)
from typing import Dict, Any, Generator, Tuple

def lf(record: Dict[str, Any]) -> Generator[Tuple[str, int, int], None, None]:
    """Yield tuples of (label_name, start_idx, end_idx)."""
    text = record.get("text", "")
    # Find spans and yield them
    for match in find_patterns(text):
        yield "entity_label", match.start, match.end

# Result format: {record_id: [[1.0, label_name, start_idx, end_idx], ...]}
def run_extraction(record_dict_list: list[dict[str, Any]]) -> dict[str, list[list[float, str, int, int]]]:
    from collections import defaultdict
    lf_results_by_record_id = defaultdict(list)
    for record_dict in record_dict_list:
        for label_name, start_idx, end_idx in lf(record_dict["data"]):
            lf_results_by_record_id[record_dict["id"]].append(
                [1.0, label_name, start_idx, end_idx]
            )
    return dict(lf_results_by_record_id)
```

### Task Type Detection
```python
# ✅ GOOD - Detect function type using inspect
import inspect

is_extraction = inspect.isgeneratorfunction(lf)

if is_extraction:
    lf_results_by_record_id.update(run_extraction(record_dict_list))
else:
    lf_results_by_record_id.update(run_classification(record_dict_list))

# ❌ BAD - Assume function type
lf_results_by_record_id.update(run_classification(record_dict_list))  # May fail for extraction
```

## DocBin Data Handling

### Loading DocBin Data
```python
# ✅ GOOD - Proper DocBin deserialization
from spacy.tokens import DocBin

def load_data_dict(record: dict[str, Any], vocab: Vocab) -> dict[str, Any]:
    """Load DocBin data from hex-encoded bytes."""
    # Validate byte format
    if record["bytes"][:2] != "\\x":
        raise ValueError("Unknown byte format in DocBin. Please contact the support.")
    
    # Remove \\x prefix and convert hex to bytes
    hex_string = record["bytes"][2:]
    byte = bytes.fromhex(hex_string)
    
    # Deserialize DocBin
    doc_bin_loaded = DocBin().from_bytes(byte)
    docs = list(doc_bin_loaded.get_docs(vocab))
    
    # Build data dictionary
    data_dict = {}
    for col, doc in zip(record["columns"], docs):
        data_dict[col] = doc
    
    # Add other record fields
    for key in record:
        if key not in ["record_id", "bytes", "columns"]:
            data_dict[key] = record[key]
    
    return data_dict

# ❌ BAD - Missing validation or incorrect byte handling
def load_data_dict(record: dict[str, Any], vocab: Vocab) -> dict[str, Any]:
    byte = bytes.fromhex(record["bytes"])  # Missing \\x prefix removal
    doc_bin_loaded = DocBin().from_bytes(byte)
    # ...
```

